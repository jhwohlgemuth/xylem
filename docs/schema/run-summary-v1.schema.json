{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://xylem.ornl.gov/schema/run-summary-v1.schema.json",
  "title": "Xylem run summary version 1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "configuration",
    "dry_run",
    "started_at_ms",
    "finished_at_ms",
    "duration_ms",
    "status",
    "error",
    "inputs"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "run_id": { "type": "string", "minLength": 1 },
    "configuration": { "$ref": "#/$defs/configuration" },
    "dry_run": { "type": "boolean" },
    "started_at_ms": { "type": "integer", "minimum": 0 },
    "finished_at_ms": { "type": ["integer", "null"], "minimum": 0 },
    "duration_ms": { "type": ["integer", "null"], "minimum": 0 },
    "status": { "enum": ["succeeded", "failed", "interrupted"] },
    "error": { "type": ["string", "null"], "maxLength": 4096 },
    "inputs": {
      "type": "array",
      "items": { "$ref": "#/$defs/input" }
    }
  },
  "$defs": {
    "state": {
      "enum": ["not_started", "pending", "running", "succeeded", "failed", "skipped"]
    },
    "configuration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "id", "version"],
      "properties": {
        "path": { "type": "string" },
        "id": { "type": ["string", "null"] },
        "version": { "type": ["string", "null"] }
      }
    },
    "module": {
      "type": "object",
      "additionalProperties": false,
      "required": ["index", "name", "state", "error", "started_at_ms", "updated_at_ms"],
      "properties": {
        "index": { "type": "integer", "minimum": 0 },
        "name": { "type": "string" },
        "state": { "$ref": "#/$defs/state" },
        "error": { "type": ["string", "null"], "maxLength": 4096 },
        "started_at_ms": { "type": ["integer", "null"], "minimum": 0 },
        "updated_at_ms": { "type": "integer", "minimum": 0 }
      }
    },
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "index",
        "input_id",
        "value",
        "state",
        "error",
        "started_at_ms",
        "updated_at_ms",
        "modules"
      ],
      "properties": {
        "index": { "type": "integer", "minimum": 0 },
        "input_id": { "type": "string", "minLength": 1 },
        "value": { "type": ["string", "null"] },
        "state": { "$ref": "#/$defs/state" },
        "error": { "type": ["string", "null"], "maxLength": 4096 },
        "started_at_ms": { "type": ["integer", "null"], "minimum": 0 },
        "updated_at_ms": { "type": "integer", "minimum": 0 },
        "modules": {
          "type": "array",
          "items": { "$ref": "#/$defs/module" }
        }
      }
    }
  }
}
