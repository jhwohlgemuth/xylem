{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://xylem.ornl.gov/schema/run-summary-v11.schema.json",
  "title": "Xylem run summary version 11",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "artifacts",
    "schema_version",
    "run_id",
    "configuration",
    "dry_run",
    "started_at",
    "finished_at",
    "duration",
    "status",
    "error",
    "sandbox",
    "gpu_monitoring",
    "containers",
    "inputs",
    "memory"
  ],
  "properties": {
    "schema_version": { "const": 11 },
    "artifacts": {
      "oneOf": [
        { "type": "null" },
        { "$ref": "#/$defs/artifacts" }
      ]
    },
    "run_id": { "type": "string", "minLength": 1 },
    "configuration": { "$ref": "#/$defs/configuration" },
    "dry_run": { "type": "boolean" },
    "started_at": { "type": "integer", "minimum": 0 },
    "finished_at": { "type": ["integer", "null"], "minimum": 0 },
    "duration": { "type": ["integer", "null"], "minimum": 0 },
    "status": { "enum": ["cancelled", "succeeded", "failed", "interrupted"] },
    "error": { "type": ["string", "null"], "maxLength": 4096 },
    "sandbox": { "$ref": "#/$defs/sandbox" },
    "gpu_monitoring": {
      "oneOf": [
        { "type": "null" },
        { "$ref": "#/$defs/gpu_monitoring" }
      ]
    },
    "containers": { "type": "array", "items": { "$ref": "#/$defs/container" } },
    "inputs": { "type": "array", "items": { "$ref": "#/$defs/input" } },
    "memory": {
      "oneOf": [
        { "type": "null" },
        { "$ref": "#/$defs/memory" }
      ]
    }
  },
  "$defs": {
    "artifacts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["bytes", "bytes_per_input", "destination", "entries", "entries_per_input", "error", "status"],
      "properties": {
        "bytes": { "type": "string", "pattern": "^\\d+(\\.\\d+)?\\s*(GB|KB|MB|TB)$" },
        "bytes_per_input": { "type": "string", "pattern": "^\\d+(\\.\\d+)?\\s*(GB|KB|MB|TB)$" },
        "destination": { "type": "string", "minLength": 1 },
        "entries": { "type": "integer", "minimum": 0 },
        "entries_per_input": { "type": "integer", "minimum": 1 },
        "error": { "type": ["string", "null"], "maxLength": 4096 },
        "status": { "enum": ["discarded", "failed", "pending", "published"] }
      }
    },
    "configuration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path"],
      "properties": {
        "path": { "type": "string" },
        "id": { "type": ["string", "null"] },
        "version": { "type": ["string", "null"] }
      }
    },
    "container": {
      "type": "object",
      "additionalProperties": false,
      "required": ["index", "name", "owned", "runtime", "state", "error", "updated_at"],
      "properties": {
        "index": { "type": "integer", "minimum": 0 },
        "name": { "type": "string" },
        "owned": { "type": "boolean" },
        "runtime": { "type": "string" },
        "state": { "enum": ["not_started", "ready", "removed", "retained", "external", "failed"] },
        "error": { "type": ["string", "null"], "maxLength": 4096 },
        "updated_at": { "type": "integer", "minimum": 0 }
      }
    },
    "gpu_device": {
      "type": "object",
      "additionalProperties": false,
      "required": ["index", "name", "memory_total_mib", "memory_used_mib", "samples", "utilization_percent", "uuid"],
      "properties": {
        "index": { "type": "integer", "minimum": 0 },
        "name": { "type": "string", "minLength": 1 },
        "memory_total_mib": { "type": ["integer", "null"], "minimum": 0 },
        "memory_used_mib": {
          "oneOf": [
            { "type": "null" },
            { "$ref": "#/$defs/gpu_metric" }
          ]
        },
        "samples": { "type": "integer", "minimum": 0 },
        "utilization_percent": {
          "oneOf": [
            { "type": "null" },
            { "$ref": "#/$defs/gpu_metric" }
          ]
        },
        "uuid": { "type": "string", "minLength": 1 }
      }
    },
    "gpu_metric": {
      "type": "object",
      "additionalProperties": false,
      "required": ["average", "maximum", "samples"],
      "properties": {
        "average": { "type": "integer", "minimum": 0 },
        "maximum": { "type": "integer", "minimum": 0 },
        "samples": { "type": "integer", "minimum": 1 }
      }
    },
    "gpu_monitoring": {
      "type": "object",
      "additionalProperties": false,
      "required": ["error", "interval", "status", "devices"],
      "properties": {
        "error": { "type": ["string", "null"], "maxLength": 4096 },
        "interval": { "const": 1100 },
        "status": { "enum": ["complete", "degraded", "interrupted", "unavailable"] },
        "devices": { "type": "array", "items": { "$ref": "#/$defs/gpu_device" } }
      }
    },
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": ["index", "input_id", "value", "state", "error", "started_at", "updated_at", "modules"],
      "properties": {
        "index": { "type": "integer", "minimum": 0 },
        "input_id": { "type": "string", "minLength": 1 },
        "value": { "type": ["string", "null"] },
        "state": { "$ref": "#/$defs/state" },
        "error": { "type": ["string", "null"], "maxLength": 4096 },
        "started_at": { "type": ["integer", "null"], "minimum": 0 },
        "updated_at": { "type": "integer", "minimum": 0 },
        "modules": { "type": "array", "items": { "$ref": "#/$defs/module" } }
      }
    },
    "memory": {
      "type": "object",
      "additionalProperties": false,
      "required": ["budget", "estimator_identity", "inputs", "mode", "safety_millionths"],
      "properties": {
        "budget": { "$ref": "#/$defs/memory_quantity" },
        "estimator_identity": { "type": "string", "minLength": 1 },
        "inputs": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/memory_input" } },
        "mode": { "enum": ["fixed_fallback", "memory_aware"] },
        "safety_millionths": { "type": "integer", "minimum": 1000000 }
      }
    },
    "memory_fallback": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "maximum_input", "minimum_input"],
          "properties": {
            "kind": { "const": "input_out_of_range" },
            "maximum_input": { "$ref": "#/$defs/memory_quantity" },
            "minimum_input": { "$ref": "#/$defs/memory_quantity" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["detail", "kind"],
          "properties": {
            "detail": { "type": "string", "minLength": 1, "maxLength": 4096 },
            "kind": { "const": "input_unavailable" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind"],
          "properties": { "kind": { "const": "no_input" } }
        }
      ]
    },
    "memory_input": {
      "type": "object",
      "additionalProperties": false,
      "required": ["estimated", "fallback", "input", "input_index", "observed_peak", "reservation", "safety_reserve"],
      "properties": {
        "estimated": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/memory_quantity" }] },
        "fallback": { "$ref": "#/$defs/memory_fallback" },
        "input": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/memory_quantity" }] },
        "input_index": { "type": "integer", "minimum": 0 },
        "observed_peak": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/memory_quantity" }] },
        "reservation": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/memory_quantity" }] },
        "safety_reserve": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/memory_quantity" }] }
      }
    },
    "memory_quantity": {
      "type": "string",
      "pattern": "^\\d+(\\.\\d+)?\\s*(GB|KB|MB|TB)$"
    },
    "module": {
      "type": "object",
      "additionalProperties": false,
      "required": ["index", "name", "module_path", "state", "error", "started_at", "updated_at"],
      "properties": {
        "index": { "type": "integer", "minimum": 0 },
        "name": { "type": "string" },
        "module_path": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "state": { "$ref": "#/$defs/state" },
        "error": { "type": ["string", "null"], "maxLength": 4096 },
        "started_at": { "type": ["integer", "null"], "minimum": 0 },
        "updated_at": { "type": "integer", "minimum": 0 }
      }
    },
    "sandbox": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode"],
      "allOf": [
        {
          "if": { "properties": { "mode": { "const": "required" } }, "required": ["mode"] },
          "then": {
            "required": ["lifecycle", "minimum_isolation", "policy_digest", "preparation_network", "process_guards", "provider", "realized_capabilities", "resources", "session_model", "workload"]
          }
        },
        {
          "if": { "properties": { "provider": { "enum": ["oci", "openshell"] } }, "required": ["provider"] },
          "then": { "required": ["runtime"] }
        }
      ],
      "properties": {
        "lifecycle": { "$ref": "#/$defs/sandbox_lifecycle" },
        "minimum_isolation": { "enum": ["process", "shared_kernel", "separate_kernel"] },
        "mode": { "enum": ["off", "required"] },
        "policy_digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "preparation_network": { "enum": ["deny", "unrestricted"] },
        "process_guards": { "type": "array", "uniqueItems": true, "items": { "enum": ["bubblewrap", "nono", "nsjail"] } },
        "provider": { "enum": ["docker_sandbox", "oci", "openshell"] },
        "realized_capabilities": {
          "type": "object",
          "additionalProperties": false,
          "required": ["isolation", "network_deny", "provider", "read_only_root", "resource_limits", "rootless"],
          "properties": {
            "isolation": { "enum": ["process", "shared_kernel", "separate_kernel"] },
            "network_deny": { "type": "boolean" },
            "provider": { "enum": ["docker_sandbox", "oci", "openshell"] },
            "read_only_root": { "type": "boolean" },
            "resource_limits": { "type": "boolean" },
            "rootless": { "type": "boolean" }
          }
        },
        "resources": {
          "type": "object",
          "additionalProperties": false,
          "required": ["artifact_bytes", "artifact_files", "captured_output_bytes", "cpu_millis", "memory_bytes", "pids", "scratch_bytes", "wall_time_seconds"],
          "properties": {
            "artifact_bytes": { "type": "integer", "minimum": 1 },
            "artifact_files": { "type": "integer", "minimum": 1 },
            "captured_output_bytes": { "type": "integer", "minimum": 1 },
            "cpu_millis": { "type": "integer", "minimum": 1 },
            "memory_bytes": { "type": "integer", "minimum": 1 },
            "pids": { "type": "integer", "minimum": 1 },
            "scratch_bytes": { "type": "integer", "minimum": 1 },
            "wall_time_seconds": { "type": "integer", "minimum": 1 }
          }
        },
        "runtime": { "enum": ["docker", "podman"] },
        "session_model": { "const": "per_input" },
        "workload": { "type": "string" }
      }
    },
    "sandbox_lifecycle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["error", "finalized", "reconciled", "resources", "retention", "stale_after_seconds"],
      "properties": {
        "error": { "type": ["string", "null"], "maxLength": 4096 },
        "finalized": { "type": "boolean" },
        "reconciled": { "type": "array", "items": { "$ref": "#/$defs/sandbox_resource" } },
        "resources": { "type": "array", "items": { "$ref": "#/$defs/sandbox_resource" } },
        "retention": { "enum": ["delete", "retain_on_failure"] },
        "stale_after_seconds": { "type": "integer", "minimum": 1 }
      }
    },
    "sandbox_resource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["error", "identifier", "input_index", "phase", "status"],
      "properties": {
        "error": { "type": ["string", "null"], "maxLength": 4096 },
        "identifier": { "type": "string", "minLength": 1 },
        "input_index": { "type": "integer", "minimum": 0 },
        "phase": { "enum": ["execution", "preparation"] },
        "status": { "enum": ["failed", "reconciled", "removed", "retained"] }
      }
    },
    "state": {
      "enum": ["not_started", "pending", "running", "succeeded", "failed", "cancelled", "skipped", "skipped_existing"]
    }
  }
}
