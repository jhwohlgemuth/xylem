{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://xylem.ornl.gov/schema/run-summary-v7.schema.json",
  "title": "Xylem run summary version 7",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "configuration",
    "dry_run",
    "started_at_ms",
    "finished_at_ms",
    "duration_ms",
    "status",
    "error",
    "gpu_monitoring",
    "containers",
    "inputs"
  ],
  "properties": {
    "schema_version": { "const": 7 },
    "run_id": { "type": "string", "minLength": 1 },
    "configuration": { "$ref": "#/$defs/configuration" },
    "dry_run": { "type": "boolean" },
    "started_at_ms": { "type": "integer", "minimum": 0 },
    "finished_at_ms": { "type": ["integer", "null"], "minimum": 0 },
    "duration_ms": { "type": ["integer", "null"], "minimum": 0 },
    "status": { "enum": ["cancelled", "succeeded", "failed", "interrupted"] },
    "error": { "type": ["string", "null"], "maxLength": 4096 },
    "gpu_monitoring": {
      "oneOf": [
        { "type": "null" },
        { "$ref": "#/$defs/gpu_monitoring" }
      ]
    },
    "containers": { "type": "array", "items": { "$ref": "#/$defs/container" } },
    "inputs": { "type": "array", "items": { "$ref": "#/$defs/input" } }
  },
  "$defs": {
    "configuration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path"],
      "properties": {
        "path": { "type": "string" },
        "id": { "type": ["string", "null"] },
        "version": { "type": ["string", "null"] }
      }
    },
    "container": {
      "type": "object",
      "additionalProperties": false,
      "required": ["index", "name", "owned", "runtime", "state", "error", "updated_at_ms"],
      "properties": {
        "index": { "type": "integer", "minimum": 0 },
        "name": { "type": "string" },
        "owned": { "type": "boolean" },
        "runtime": { "type": "string" },
        "state": { "enum": ["not_started", "ready", "removed", "retained", "external", "failed"] },
        "error": { "type": ["string", "null"], "maxLength": 4096 },
        "updated_at_ms": { "type": "integer", "minimum": 0 }
      }
    },
    "gpu_device": {
      "type": "object",
      "additionalProperties": false,
      "required": ["index", "name", "memory_total_mib", "memory_used_mib", "samples", "utilization_percent", "uuid"],
      "properties": {
        "index": { "type": "integer", "minimum": 0 },
        "name": { "type": "string", "minLength": 1 },
        "memory_total_mib": { "type": ["integer", "null"], "minimum": 0 },
        "memory_used_mib": {
          "oneOf": [
            { "type": "null" },
            { "$ref": "#/$defs/gpu_metric" }
          ]
        },
        "samples": { "type": "integer", "minimum": 0 },
        "utilization_percent": {
          "oneOf": [
            { "type": "null" },
            { "$ref": "#/$defs/gpu_metric" }
          ]
        },
        "uuid": { "type": "string", "minLength": 1 }
      }
    },
    "gpu_metric": {
      "type": "object",
      "additionalProperties": false,
      "required": ["average", "maximum", "samples"],
      "properties": {
        "average": { "type": "integer", "minimum": 0 },
        "maximum": { "type": "integer", "minimum": 0 },
        "samples": { "type": "integer", "minimum": 1 }
      }
    },
    "gpu_monitoring": {
      "type": "object",
      "additionalProperties": false,
      "required": ["error", "interval", "status", "devices"],
      "properties": {
        "error": { "type": ["string", "null"], "maxLength": 4096 },
        "interval": { "const": 1000 },
        "status": { "enum": ["complete", "degraded", "interrupted", "unavailable"] },
        "devices": { "type": "array", "items": { "$ref": "#/$defs/gpu_device" } }
      }
    },
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": ["index", "input_id", "value", "state", "error", "started_at_ms", "updated_at_ms", "modules"],
      "properties": {
        "index": { "type": "integer", "minimum": 0 },
        "input_id": { "type": "string", "minLength": 1 },
        "value": { "type": ["string", "null"] },
        "state": { "$ref": "#/$defs/state" },
        "error": { "type": ["string", "null"], "maxLength": 4096 },
        "started_at_ms": { "type": ["integer", "null"], "minimum": 0 },
        "updated_at_ms": { "type": "integer", "minimum": 0 },
        "modules": { "type": "array", "items": { "$ref": "#/$defs/module" } }
      }
    },
    "module": {
      "type": "object",
      "additionalProperties": false,
      "required": ["index", "name", "module_path", "state", "error", "started_at_ms", "updated_at_ms"],
      "properties": {
        "index": { "type": "integer", "minimum": 0 },
        "name": { "type": "string" },
        "module_path": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "state": { "$ref": "#/$defs/state" },
        "error": { "type": ["string", "null"], "maxLength": 4096 },
        "started_at_ms": { "type": ["integer", "null"], "minimum": 0 },
        "updated_at_ms": { "type": "integer", "minimum": 0 }
      }
    },
    "state": {
      "enum": ["not_started", "pending", "running", "succeeded", "failed", "cancelled", "skipped", "skipped_existing"]
    }
  }
}
