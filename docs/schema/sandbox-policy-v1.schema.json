{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://xylem.ornl.gov/schema/sandbox-policy-v1.schema.json",
  "title": "Xylem sandbox operator policy version 1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "environment",
    "lifecycle",
    "minimum_isolation",
    "paths",
    "preparation_network",
    "process_guards",
    "provider",
    "resources",
    "version",
    "workload"
  ],
  "properties": {
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["allow"],
      "properties": {
        "allow": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[A-Z0-9_]+$" }
        }
      }
    },
    "lifecycle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["retention", "stale_after_seconds"],
      "properties": {
        "retention": { "enum": ["delete", "retain_on_failure"] },
        "stale_after_seconds": { "type": "integer", "minimum": 1 }
      }
    },
    "minimum_isolation": { "enum": ["process", "shared_kernel", "separate_kernel"] },
    "paths": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact_roots", "input_roots", "module_roots"],
      "properties": {
        "artifact_roots": { "$ref": "#/$defs/paths" },
        "input_roots": { "$ref": "#/$defs/paths" },
        "module_roots": { "$ref": "#/$defs/paths" }
      }
    },
    "preparation_network": { "enum": ["deny", "unrestricted"] },
    "process_guards": {
      "type": "array",
      "maxItems": 0,
      "uniqueItems": true,
      "items": { "enum": ["bubblewrap", "nono", "nsjail"] }
    },
    "provider": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["runtime", "type"],
          "properties": {
            "runtime": { "enum": ["docker", "podman"] },
            "type": { "const": "oci" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["driver", "type"],
          "properties": {
            "driver": { "enum": ["docker", "podman"] },
            "type": { "const": "openshell" }
          }
        }
      ]
    },
    "resources": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact_bytes",
        "artifact_files",
        "captured_output_bytes",
        "cpu_millis",
        "memory_bytes",
        "pids",
        "scratch_bytes",
        "wall_time_seconds"
      ],
      "properties": {
        "artifact_bytes": { "type": "integer", "minimum": 1 },
        "artifact_files": { "type": "integer", "minimum": 1 },
        "captured_output_bytes": { "type": "integer", "minimum": 1 },
        "cpu_millis": { "type": "integer", "minimum": 1 },
        "memory_bytes": { "type": "integer", "minimum": 1 },
        "pids": { "type": "integer", "minimum": 1 },
        "scratch_bytes": { "type": "integer", "minimum": 1 },
        "wall_time_seconds": { "type": "integer", "minimum": 1 }
      }
    },
    "version": { "const": 1 },
    "workload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["allowed", "default"],
      "properties": {
        "allowed": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/workload" }
        },
        "default": { "$ref": "#/$defs/workload" }
      }
    }
  },
  "$defs": {
    "paths": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "workload": {
      "type": "string",
      "pattern": "^.+@sha256:[0-9a-f]{64}$"
    }
  }
}
