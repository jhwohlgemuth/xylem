{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://xylem.ornl.gov/schema/run-summary-v4.schema.json",
  "title": "Xylem run summary version 4",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "configuration",
    "dry_run",
    "started_at_ms",
    "finished_at_ms",
    "duration_ms",
    "status",
    "error",
    "containers",
    "inputs"
  ],
  "properties": {
    "schema_version": { "const": 4 },
    "run_id": { "type": "string", "minLength": 1 },
    "configuration": { "$ref": "#/$defs/configuration" },
    "dry_run": { "type": "boolean" },
    "started_at_ms": { "type": "integer", "minimum": 0 },
    "finished_at_ms": { "type": ["integer", "null"], "minimum": 0 },
    "duration_ms": { "type": ["integer", "null"], "minimum": 0 },
    "status": { "enum": ["succeeded", "failed", "interrupted"] },
    "error": { "type": ["string", "null"], "maxLength": 4096 },
    "containers": { "type": "array", "items": { "$ref": "#/$defs/container" } },
    "inputs": { "type": "array", "items": { "$ref": "#/$defs/input" } }
  },
  "$defs": {
    "configuration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "id", "version"],
      "properties": {
        "path": { "type": "string" },
        "id": { "type": ["string", "null"] },
        "version": { "type": ["string", "null"] }
      }
    },
    "container": {
      "type": "object",
      "additionalProperties": false,
      "required": ["index", "name", "owned", "runtime", "state", "error", "updated_at_ms"],
      "properties": {
        "index": { "type": "integer", "minimum": 0 },
        "name": { "type": "string" },
        "owned": { "type": "boolean" },
        "runtime": { "type": "string" },
        "state": { "enum": ["not_started", "ready", "removed", "retained", "external", "failed"] },
        "error": { "type": ["string", "null"], "maxLength": 4096 },
        "updated_at_ms": { "type": "integer", "minimum": 0 }
      }
    },
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": ["index", "input_id", "value", "state", "error", "started_at_ms", "updated_at_ms", "modules"],
      "properties": {
        "index": { "type": "integer", "minimum": 0 },
        "input_id": { "type": "string", "minLength": 1 },
        "value": { "type": ["string", "null"] },
        "state": { "$ref": "#/$defs/state" },
        "error": { "type": ["string", "null"], "maxLength": 4096 },
        "started_at_ms": { "type": ["integer", "null"], "minimum": 0 },
        "updated_at_ms": { "type": "integer", "minimum": 0 },
        "modules": { "type": "array", "items": { "$ref": "#/$defs/module" } }
      }
    },
    "module": {
      "type": "object",
      "additionalProperties": false,
      "required": ["index", "name", "module_path", "state", "error", "started_at_ms", "updated_at_ms"],
      "properties": {
        "index": { "type": "integer", "minimum": 0 },
        "name": { "type": "string" },
        "module_path": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "state": { "$ref": "#/$defs/state" },
        "error": { "type": ["string", "null"], "maxLength": 4096 },
        "started_at_ms": { "type": ["integer", "null"], "minimum": 0 },
        "updated_at_ms": { "type": "integer", "minimum": 0 }
      }
    },
    "state": {
      "enum": ["not_started", "pending", "running", "succeeded", "failed", "skipped", "skipped_existing"]
    }
  }
}
