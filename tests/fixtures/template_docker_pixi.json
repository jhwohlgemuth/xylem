{
    "command": "python",
    "container": {
        "name": "CONTAINER",
        "runtime": "docker"
    },
    "environment": {
        "name": "ENVIRONMENT",
        "manager": "pixi"
    },
    "arguments": [
        "-m",
        "lib",
        "--method",
        "{{ METHOD }}",
        "--profile",
        "{{ PROFILE }}"
    ]
}