{
    "version": "0.0.1",
    "description": "Test workflow configuration",
    "requirements": [
        "python",
        "conda"
    ],
    "keywords": [],
    "check": {
        "files": ["**/*.py"],
        "rules": [
            {
                "name": "is_valid_python_module"
            }
        ]
    },
    "variables": {
        "OUTPUT_DIRECTORY": "/path/to/output",
        "ANSWER": 42,
        "BOOLEAN": true,
        "TOKEN": "X12E45678N"
    },
    "modules": [
        {
            "name": "Local Binary Module",
            "type": "binary",
            "uri": "file:///path/to/wasm/module",
            "checksum": "debe0f22e2b4e8dffd88d4bbe8b15cca98c5950b1b857d1747f211465fba972e"
        },
        {
            "name": "Local Python Script Module",
            "type": "script",
            "programmingLanguage": "python",
            "uri": "file:///path/to/module"
        },
        {
            "name": "Remote Python Script Module",
            "type": "script",
            "programmingLanguage": "python",
            "uri": "https://code.ornl.gov/GSHS/GDS/Common/PIPE/module"
        }
    ]
}