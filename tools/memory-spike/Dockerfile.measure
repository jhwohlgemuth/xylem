FROM rust:1.96.0-bookworm AS builder

WORKDIR /workspace
COPY . .
RUN cargo build --locked --release --package xylem-cli --package xylem-memory-spike

FROM mambaorg/micromamba:debian-slim

COPY --chown=$MAMBA_USER:$MAMBA_USER tools/memory-spike/environment.measure.yml /tmp/environment.yml
RUN micromamba install --yes --name base --file /tmp/environment.yml && \
    micromamba clean --all --yes

# The entrypoint creates delegated cgroups for the measured process tree.
# hadolint ignore=DL3002
USER 0
COPY --from=builder /workspace/target/release/xylem /usr/local/bin/xylem
COPY --from=builder /workspace/target/release/xylem-memory-probe /usr/local/bin/xylem-memory-probe
COPY --from=builder /workspace/target/release/xylem-memory-spike /usr/local/bin/xylem-memory-spike
COPY tools/memory-spike/docker-measure-entrypoint.sh /usr/local/bin/xylem-memory-docker-measure
COPY tools/memory-spike/real /opt/xylem-memory/real

ENV PATH=/opt/conda/bin:$PATH \
    PROJ_DATA=/opt/conda/share/proj \
    PROJ_LIB=/opt/conda/share/proj \
    PYTHONDONTWRITEBYTECODE=1

ENTRYPOINT ["/usr/local/bin/xylem-memory-docker-measure"]
