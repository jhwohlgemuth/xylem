{
    "version": "0.0.9",
    "description": "Test workflow configuration",
    "requirements": [
        "python",
        "conda"
    ],
    "input": [
        "/data/test-cases/test-case-GE01-medium-low-mid",
        "/data/test-cases/test-case-WV02-medium-mid-high",
        "/data/test-cases/test-case-wv03-large-high-mid",
        "/data/test-cases/test-case-wv03-large-mid-low"
    ],
    "options": {
        "batch": 2
    },
    "modules": [
        {
            "name": "Module P (local)",
            "type": "script",
            "programmingLanguage": "python",
            "uri": "file:///path/to/module-p",
            "variables": {
                "OUTPUT_DIRECTORY": "/data/output",
                "METHOD": "nn_diffuse"
            },
            "template": {
                "command": "python",
                "environment": {
                    "name": "module-p",
                    "manager": "conda"
                },
                "arguments": [
                    "-m",
                    "lib",
                    "--source_directory",
                    "{{ INPUT }}",
                    "--output_directory",
                    "{{ OUTPUT_DIRECTORY }}",
                    "--method",
                    "{{ METHOD }}",
                    "--module_list",
                    "{{ MODULE_LIST }}"
                ]
            }
        }
    ]
}
