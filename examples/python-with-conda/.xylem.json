{
    "version": "0.0.1",
    "description": "Run Python (with conda) module example",
    "requirements": ["conda"],
    "variables": {
        "GREETING": "Hello",
        "AUDIENCE": "from Xylem",
        "MESSAGE": "{{ GREETING }} {{ AUDIENCE }}"
    },
    "modules": [
        {
            "name": "Conda Example",
            "uri": "file:.",
            "type": "script",
            "programmingLanguage": "python",
            "template": {
                "environment": {
                    "name": "example",
                    "manager": "conda"
                },
                "command": "python",
                "arguments": [
                    "-m",
                    "lib.run",
                    "--message",
                    "{{ MESSAGE }}",
                    "--modules",
                    "{{ MODULE_LIST }}"
                ]
            }
        }
    ]
}
