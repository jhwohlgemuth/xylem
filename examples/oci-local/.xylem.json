{
  "version": "1.0.0",
  "id": "oci-local",
  "description": "Run a module directly from a local OCI image layout bundle",
  "requirements": ["oras", "sh"],
  "input": ["Ada", "Grace"],
  "output": "./output",
  "modules": [
    {
      "name": "LocalBundleGreeting",
      "type": "script",
      "programmingLanguage": "generic",
      "uri": "oci-layout:./module/bundle@sha256:98970c614c6c50785f7fc7b220e2b966249e95d6705f60cbc9b451923a74f805",
      "template": {
        "command": "sh",
        "arguments": [
          "run.sh",
          "{{ INPUT }}",
          "{{ OUTPUT_DIRECTORY }}/greeting-{{ INPUT }}.txt"
        ]
      }
    }
  ]
}
